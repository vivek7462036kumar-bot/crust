# ==============================================================================
# Crust & Ember - Environment Configuration
# Reference observable & fault-injectable application for AIOps platform
# ==============================================================================

# Database connection string (SQLite file location)
DATABASE_URL="file:./dev.db"

# AIOps platform webhook URL for operational incident ingestion
AIOPS_WEBHOOK_URL="http://localhost:8000/api/v1/webhooks/generic"

# Master switch to enable/disable incident reporting to AIOps (default: true)
AIOPS_REPORTING_ENABLED="true"

# Deployment environment identifier reported to AIOps (production, staging, etc.)
APP_ENV="production"

# Active fault injection mode (none | missing_env | schema_drift | slow_downstream | memory_leak | readiness_fail)
FAULT_MODE="none"

# Enable or disable runtime fault management endpoints at /api/_fault/* (default: true)
FAULT_ENDPOINTS_ENABLED="true"

# Secret token required in header 'x-fault-token' to update fault modes via /api/_fault/set
FAULT_ADMIN_TOKEN="crust-secret-token"

# Memory RSS threshold in megabytes to trigger OOM alert in memory watcher (default: 200)
MEMORY_ALERT_MB="200"

# Latency threshold in milliseconds before route handler triggers a high-latency warning (default: 3000)
LATENCY_THRESHOLD_MS="3000"

# Downstream delivery quote microservice URL used during order checkout
DELIVERY_QUOTE_URL="http://delivery-service:8080/quote"

# External Docker network name for joining the AIOps platform compose network
AIOPS_NETWORK="aiops-network"
